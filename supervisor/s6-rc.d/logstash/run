#!/command/execlineb -P
# dependencies.d/redis only orders "redis's own process has been exec'd"
# before this -- s6-rc has no readiness notification for a plain `longrun`
# service (redis's own `type` here), so it does NOT mean "redis is actually
# accepting TCP connections yet". Confirmed the hard way: without this
# wait, logstash's very first connection attempt (during the real, if
# short, window between redis's process starting and its listener actually
# binding) hits ECONNREFUSED -- and logstash-output-redis's own retry
# logic doesn't recover from that cleanly, getting the pipeline's first
# event permanently wedged retrying forever, never delivering anything
# after it either. This window is NOT always short: confirmed empirically
# on a real deployment (network_mode: host, a bind-mounted, already-
# populated ${CTTC_REDIS_DATA_DIR} volume -- RDB load time scales with
# however much history is already there, and Docker Desktop's bind-mount
# I/O on macOS is its own added latency on top) that redis-server can take
# 30+ seconds to print "Ready to accept connections", not the sub-5s this
# was first tuned against. 240 tries * 0.5s = 120s ceiling; falls through
# to exec logstash regardless (never blocks startup forever) since a redis
# that's still not up after 120s is a real, different failure this can't
# paper over anyway -- logstash's own ordinary reconnect handles a redis
# that comes up *after* this point just fine, this is only about the
# initial race. Logs its own progress every 10s so a slow-but-working wait
# doesn't read as a silent hang.
fdmove -c 2 1
foreground {
  sh -c "i=0; while [ $i -lt 240 ]; do redis-cli -h 127.0.0.1 -p 6379 ping >/dev/null 2>&1 && { echo \"logstash/run: redis ready after $((i / 2))s, starting logstash\" >&2; exit 0; }; i=$((i+1)); [ $((i % 20)) -eq 0 ] && echo \"logstash/run: still waiting for redis ($((i / 2))s so far)...\" >&2; sleep 0.5; done; echo 'logstash/run: redis still not accepting connections after 120s, starting anyway' >&2"
}
exec logstash --path.settings /usr/share/logstash/config
